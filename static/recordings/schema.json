{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blog.openadapt.ai/recordings/schema.json",
  "title": "OpenAdapt Recording Manifest",
  "description": "Manifest describing an OpenAdapt recording that can be replayed via the desktop app or CLI.",
  "type": "object",
  "required": ["id", "title", "version", "steps", "platform", "download_url", "checksum_sha256", "created_at", "actions_summary"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique recording identifier.",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "description": "Human-readable title of the recording."
    },
    "version": {
      "type": "integer",
      "description": "Manifest schema version.",
      "minimum": 1
    },
    "steps": {
      "type": "integer",
      "description": "Total number of automation steps.",
      "minimum": 1
    },
    "platform": {
      "type": "string",
      "description": "Target operating system.",
      "enum": ["macos", "windows", "linux"]
    },
    "min_openadapt_version": {
      "type": "string",
      "description": "Minimum OpenAdapt version required to replay.",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "download_url": {
      "type": "string",
      "description": "URL to download the recording archive.",
      "format": "uri"
    },
    "checksum_sha256": {
      "type": "string",
      "description": "SHA-256 checksum of the recording archive.",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature_url": {
      "type": "string",
      "description": "URL to the Ed25519 signature file for verification.",
      "format": "uri"
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of when the recording was created.",
      "format": "date-time"
    },
    "author": {
      "type": "string",
      "description": "Who created the recording."
    },
    "estimated_duration_seconds": {
      "type": "integer",
      "description": "Estimated replay duration in seconds.",
      "minimum": 1
    },
    "actions_summary": {
      "type": "array",
      "description": "Human-readable summary of each step.",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "tags": {
      "type": "array",
      "description": "Tags for categorization.",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
